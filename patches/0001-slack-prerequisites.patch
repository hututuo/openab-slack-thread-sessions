+//! Thread-bound Slack controls backed by ACP configOptions, never model prompts.
+use crate::acp::protocol::ConfigOption;
+use serde_json::{json, Value};
+use std::time::{Duration, Instant};
+
+pub const ACTION: &str = "openab_model_select";
+pub const TTL: Duration = Duration::from_secs(15 * 60);
+#[derive(Clone)]
+pub struct Menu {
+    pub team: String,
+    pub channel: String,
+    pub thread: String,
+    pub message: String,
+    pub session: String,
+    pub owner: String,
+    pub options: Vec<ConfigOption>,
+    pub created: Instant,
+}
+impl Menu {
+    pub fn selection(&self, payload: &Value, now: Instant) -> Result<(String, String), &'static str> {
+        if now.saturating_duration_since(self.created) > TTL { return Err("菜单已过期，请重新发送“模型”。"); }
+        if payload["user"]["id"].as_str() != Some(&self.owner) { return Err("仅 owner 可以切换模型。"); }
+        if payload["team"]["id"].as_str() != Some(&self.team)
+            || payload["channel"]["id"].as_str() != Some(&self.channel)
+            || payload["message"]["thread_ts"].as_str() != Some(&self.thread)
+            || payload["container"]["message_ts"].as_str() != Some(&self.message)
+            || payload["message"]["ts"].as_str() != Some(&self.message) {
+            return Err("菜单不属于当前线程，请重新发送“模型”。");
+        }
+        let actions = payload["actions"].as_array().ok_or("无效模型选择。")?;
+        if actions.len() != 1 || actions[0]["action_id"] != ACTION { return Err("无效模型选择。"); }
+        let selected = actions[0]["selected_option"]["value"].as_str().ok_or("无效模型选择。")?;
+        for opt in &self.options {
+            if opt.category.as_deref() == Some("model") && opt.options.iter().any(|v| v.value == selected) {
+                return Ok((opt.id.clone(), selected.to_string()));
+            }
+        }
+        Err("该模型不在此菜单的后端列表中，请重新发送“模型”。")
+    }
+}
+pub fn blocks(options: &[ConfigOption], token: &str) -> Option<Vec<Value>> {
+    let models: Vec<_> = options.iter().filter(|o| o.category.as_deref() == Some("model") && o.option_type == "select").collect();
+    let current = models.iter().map(|o| o.current_value.as_str()).collect::<Vec<_>>().join("、");
+    let mut blocks = vec![json!({"type":"section","text":{"type":"plain_text","text":format!("当前模型：{current}\n仅 owner 可选择；只影响此线程，下一轮使用所选模型。")}})];
+    let mut count = 0;
+    for opt in models {
+        let choices: Vec<Value> = opt.options.iter().filter(|v| !v.value.is_empty() && v.value.len() <= 150)
+            .map(|v|json!({"text":{"type":"plain_text","text":v.name.chars().take(75).collect::<String>()},"value":v.value})).collect();
+        for chunk in choices.chunks(100) {
+            // Slack allows at most 50 blocks per message. No silently hidden rows.
+            if blocks.len() >= 49 { return None; }
+            let mut select = json!({"type":"static_select","action_id":ACTION,"placeholder":{"type":"plain_text","text":"选择此线程的模型"},"options":chunk});
+            if let Some(current) = chunk.iter().find(|v| v["value"].as_str() == Some(&opt.current_value)) { select["initial_option"] = current.clone(); }
+            blocks.push(json!({"type":"actions","block_id":format!("{token}:{count}"),"elements":[select]}));
+            count += 1;
+        }
+    }
+    if count == 0 { None } else { Some(blocks) }
+}
+pub fn menu_token(payload: &Value) -> Option<&str> {
+    let actions = payload["actions"].as_array()?;
+    if payload["type"] != "block_actions" || actions.len()!=1 || actions[0]["action_id"] != ACTION { return None; }
+    let id=actions[0]["block_id"].as_str()?;
+    id.split_once(':').map(|(token,_)|token).filter(|token|token.starts_with("openab-model-"))
+}
