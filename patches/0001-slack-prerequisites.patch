+    /// Nonblocking snapshot for interactive controls. None means a turn is busy.
+    pub async fn try_config_snapshot(&self, thread_id: &str) -> Result<Option<(String, Vec<ConfigOption>)>> {
+        let conn = self.state.read().await.active.get(thread_id).cloned()
+            .ok_or_else(|| anyhow!("no active session"))?;
+        let Ok(conn) = conn.try_lock() else { return Ok(None); };
+        let session = conn.acp_session_id.clone().ok_or_else(|| anyhow!("no ACP session"))?;
+        Ok(Some((session, conn.config_options.clone())))
+    }
+
+    /// Never queue a stale menu selection behind a running prompt or use another session.
+    pub async fn try_set_config_for_session(&self, thread_id: &str, expected_session: &str,
+        config_id: &str, value: &str) -> Result<Option<Vec<ConfigOption>>> {
+        let conn = self.state.read().await.active.get(thread_id).cloned()
+            .ok_or_else(|| anyhow!("stale model menu"))?;
+        let Ok(mut conn) = conn.try_lock() else { return Ok(None); };
+        if conn.acp_session_id.as_deref() != Some(expected_session) {
+            return Err(anyhow!("stale model menu"));
+        }
+        if !conn.config_options.iter().any(|o| o.id == config_id && o.category.as_deref() == Some("model")
+            && o.options.iter().any(|v| v.value == value)) {
+            return Err(anyhow!("model no longer offered by backend"));
+        }
+        Ok(Some(conn.set_config_option(config_id, value).await?))
     }
 
