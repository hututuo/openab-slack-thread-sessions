+/// Human channel mentions are delivered via app_mention; bot mentions must use
+/// message events and retain the trust + configured turn-limit checks there.
+fn route_mention_via_app_event(is_bot: bool, is_dm: bool, mentions_bot: bool) -> bool {
+    mentions_bot && !is_dm && !is_bot
+}
+
+fn route_mention_via_message_event(is_bot: bool, is_dm: bool, mentions_bot: bool) -> bool {
+    mentions_bot && !route_mention_via_app_event(is_bot, is_dm, mentions_bot)
+}
+
+/// Slack-only unlimited mode. Never enter the shared tracker at zero: it has
+/// both a soft limit and an independent hard cap, used by other platforms too.
+/// Self events are ignored before either counter can change, even at a positive limit.
+fn classify_slack_bot_turn(
+    tracker: &mut BotTurnTracker,
+    max_bot_turns: u32,
+    thread: &str,
+    is_own_bot: bool,
+) -> TurnAction {
+    if is_own_bot {
+        TurnAction::SilentStop
+    } else if max_bot_turns == 0 {
+        TurnAction::Continue
+    } else {
+        tracker.classify_bot_message(thread)
+    }
+}
+
+fn slack_history_cap_enabled(allow_bot_messages: AllowBots, max_bot_turns: u32) -> bool {
+    matches!(allow_bot_messages, AllowBots::All) && max_bot_turns > 0
+}
+
+fn slack_bot_has_target(has_thread: bool, mentions_bot: bool) -> bool {
+    has_thread || mentions_bot
+}
+
+fn slack_bot_has_trigger(mode: AllowBots, is_dm: bool, has_thread: bool, mentions_bot: bool) -> bool {
+    match mode {
+        AllowBots::Off => false,
+        AllowBots::Mentions => route_mention_via_message_event(true, is_dm, mentions_bot),
+        AllowBots::All => slack_bot_has_target(has_thread, mentions_bot),
+    }
+}
+
+fn slack_dm_has_trigger(allow_user_messages: AllowUsers, mentions_bot: bool) -> bool {
+    !matches!(allow_user_messages, AllowUsers::Mentions)
+        || route_mention_via_message_event(false, true, mentions_bot)
+}
+
+fn slack_is_own_sender(bot_uid: Option<&str>, sender_uid: Option<&str>) -> bool {
+    bot_uid.is_some_and(|uid| !uid.is_empty() && sender_uid == Some(uid))
+}
+
+fn reset_human_mention_turns(tracker: &mut BotTurnTracker, event: &serde_json::Value, admitted: bool) {
+    if !admitted { return; }
+    let key = event["thread_ts"].as_str().map(str::to_string).unwrap_or_else(||
+        format!("{}:{}", event["channel"].as_str().unwrap_or(""), event["ts"].as_str().unwrap_or("")));
+    tracker.on_human_message(&key);
+}
