+    #[test] fn menu_contains_current_model_and_dropdown(){let b=blocks(&[option()],"token").unwrap();assert!(b[0]["text"]["text"].as_str().unwrap().contains("m1"));assert_eq!(b[1]["elements"][0]["initial_option"]["value"],"m1");assert_eq!(b[1]["elements"][0]["options"][1]["value"],"m2");}
+    #[test] fn empty_backend_list_has_no_fabricated_menu(){assert!(blocks(&[],"token").is_none());}
