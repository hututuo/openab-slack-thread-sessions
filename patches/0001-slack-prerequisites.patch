+    #[test] fn menu_rejects_other_channel_thread_team_and_message(){for path in [("channel","id"),("team","id"),("message","thread_ts"),("message","ts"),("container","message_ts")] {let mut p=payload();p[path.0][path.1]=json!("other");assert!(menu().selection(&p,Instant::now()).is_err());}}
