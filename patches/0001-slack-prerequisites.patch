+/// reqwest error displays can include signed attachment URLs. Keep log values
+/// static rather than rendering URLs, response content, or request headers.
+pub(crate) fn download_error_kind(error: &reqwest::Error) -> &'static str {
+    if error.is_timeout() {
+        "timeout"
+    } else if error.is_connect() {
+        "connect"
+    } else if error.is_builder() {
+        "builder"
+    } else if error.is_redirect() {
+        "redirect"
+    } else if error.is_status() {
+        "http_status"
+    } else if error.is_body() {
+        "body"
+    } else if error.is_decode() {
+        "decode"
+    } else if error.is_request() {
+        "request"
+    } else {
+        "network"
+    }
+}
 
