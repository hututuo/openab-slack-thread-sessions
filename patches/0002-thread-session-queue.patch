+/// A reservation pins this thread's connection between ensure_session and prompt.
+/// Drop (including cancellation/error unwinding) releases both scopes.
+pub struct SessionTurn {
+    key: String,
+    pinned: Arc<std::sync::Mutex<HashMap<String, tokio::sync::watch::Sender<bool>>>>,
+    cancelled: tokio::sync::watch::Receiver<bool>,
+    _capacity: OwnedSemaphorePermit,
+    _thread: OwnedMutexGuard<()>,
+}
+
+impl SessionTurn {
+    /// Hung-session recovery signals the exact reservation after process teardown.
+    /// The caller drops its prompt future before releasing this reservation.
+    pub async fn cancelled(&mut self) {
+        loop {
+            if *self.cancelled.borrow_and_update() { return; }
+            if self.cancelled.changed().await.is_err() { return; }
+        }
+    }
+}
+
+impl Drop for SessionTurn {
+    fn drop(&mut self) {
+        self.pinned.lock().unwrap().remove(&self.key);
+    }
+}
+
+struct TurnAdmission {
+    gates: std::sync::Mutex<HashMap<String, std::sync::Weak<Mutex<()>>>>,
+    capacity: Arc<Semaphore>,
+    pinned: Arc<std::sync::Mutex<HashMap<String, tokio::sync::watch::Sender<bool>>>>,
+}
+
+impl TurnAdmission {
+    fn new(capacity: usize) -> Self {
+        Self {
+            gates: std::sync::Mutex::new(HashMap::new()),
+            capacity: Arc::new(Semaphore::new(capacity)),
+            pinned: Arc::new(std::sync::Mutex::new(HashMap::new())),
+        }
+    }
+
+    fn gate(&self, key: &str) -> Arc<Mutex<()>> {
+        let mut gates = self.gates.lock().unwrap();
+        gates.retain(|_, gate| gate.strong_count() > 0);
+        if let Some(gate) = gates.get(key).and_then(std::sync::Weak::upgrade) {
+            return gate;
+        }
+        let gate = Arc::new(Mutex::new(()));
+        gates.insert(key.to_owned(), Arc::downgrade(&gate));
+        gate
+    }
+
+    fn pin(&self, key: &str, thread: OwnedMutexGuard<()>, capacity: OwnedSemaphorePermit) -> SessionTurn {
+        let (cancel, cancelled) = tokio::sync::watch::channel(false);
+        self.pinned.lock().unwrap().insert(key.to_owned(), cancel);
+        SessionTurn { key: key.to_owned(), pinned: self.pinned.clone(), cancelled, _thread: thread, _capacity: capacity }
+    }
+
+    async fn acquire(&self, key: &str) -> Result<SessionTurn> {
+        // Same-thread waiters must not occupy scarce global slots.
+        let thread = self.gate(key).lock_owned().await;
+        let capacity = self.capacity.clone().acquire_owned().await
+            .map_err(|_| anyhow!("session pool is shutting down"))?;
+        Ok(self.pin(key, thread, capacity))
+    }
+
+    fn try_acquire(&self, key: &str) -> Option<SessionTurn> {
+        let thread = self.gate(key).try_lock_owned().ok()?;
+        let capacity = self.capacity.clone().try_acquire_owned().ok()?;
+        Some(self.pin(key, thread, capacity))
+    }
+
+    fn is_pinned(&self, key: &str) -> bool {
+        self.pinned.lock().unwrap().contains_key(key)
+    }
 }
 
