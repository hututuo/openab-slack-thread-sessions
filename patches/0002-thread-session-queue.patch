+    #[tokio::test]
+    async fn slack_ingress_preserves_receive_order_without_blocking_other_threads() {
+        let mut order = SlackIngressOrder::default();
+        let a1 = order.register("T:C:A".into());
+        let a2 = order.register("T:C:A".into());
+        let b = order.register("T:C:B".into());
+        let (release, slow_preparation) = tokio::sync::oneshot::channel::<()>();
+        let (submitted, mut submissions) = tokio::sync::mpsc::unbounded_channel();
+        let first_sender = submitted.clone();
+        let first = tokio::spawn(async move {
+            let _turn = a1.wait().await;
+            let _ = slow_preparation.await;
+            first_sender.send("A1").unwrap();
+        });
+        let second_sender = submitted.clone();
+        // Deliberately spawn A2 before independent B, while A1 remains slow.
+        let second = tokio::spawn(async move {
+            let _turn = a2.wait().await;
+            second_sender.send("A2").unwrap();
+        });
+        let independent = tokio::spawn(async move {
+            let _turn = b.wait().await;
+            submitted.send("B").unwrap();
+        });
+        assert_eq!(tokio::time::timeout(std::time::Duration::from_secs(1), submissions.recv()).await.unwrap(), Some("B"));
+        assert!(matches!(submissions.try_recv(), Err(tokio::sync::mpsc::error::TryRecvError::Empty)));
+        release.send(()).unwrap();
+        assert_eq!(submissions.recv().await, Some("A1"));
+        assert_eq!(submissions.recv().await, Some("A2"));
+        first.await.unwrap();
+        second.await.unwrap();
+        independent.await.unwrap();
+    }
