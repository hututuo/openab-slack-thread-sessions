+/// Socket Mode can redeliver an event after reconnect or acknowledgement loss.
+/// Claim only the selected app_mention/message route, so an ignored message
+/// event cannot consume the corresponding app_mention. Kept across reconnects.
+#[derive(Default)]
+struct SlackEventDeduper {
+    seen: HashMap<String, std::time::Instant>,
+}
+
+impl SlackEventDeduper {
+    const TTL: std::time::Duration = std::time::Duration::from_secs(600);
+    const MAX: usize = 10_000;
+
+    fn claim(&mut self, team: &str, event: &serde_json::Value, now: std::time::Instant) -> bool {
+        let Some(channel) = event["channel"].as_str().filter(|id| !id.is_empty()) else { return false; };
+        let Some(ts) = event["ts"].as_str().filter(|id| !id.is_empty()) else { return false; };
+        if team.is_empty() { return false; }
+        let key = slack_thread_identity(team, channel, ts);
+        if self.seen.get(&key).is_some_and(|seen| now.saturating_duration_since(*seen) < Self::TTL) {
+            return false;
+        }
+        if self.seen.len() >= Self::MAX {
+            self.seen.retain(|_, seen| now.saturating_duration_since(*seen) < Self::TTL);
+            if self.seen.len() >= Self::MAX {
+                if let Some(oldest) = self.seen.iter().min_by_key(|(_, seen)| **seen).map(|(key, _)| key.clone()) {
+                    self.seen.remove(&oldest);
+                }
+            }
+        }
+        self.seen.insert(key, now);
+        true
+    }
+}
+
+/// Registered synchronously by the Socket Mode receive loop. A mutex first
+/// acquired inside spawned tasks would order task scheduling, not event arrival.
+#[derive(Default)]
+struct SlackIngressOrder {
+    tails: HashMap<String, watch::Receiver<bool>>,
+}
+
+struct SlackIngressTurn {
+    predecessor: Option<watch::Receiver<bool>>,
+    // Dropping this sender (including panic/abort) releases the completion bridge.
+    _finished: tokio::sync::oneshot::Sender<()>,
+}
+
+async fn wait_for_slack_ingress(mut predecessor: Option<watch::Receiver<bool>>) {
+    if let Some(previous) = predecessor.as_mut() {
+        loop {
+            let completed = *previous.borrow_and_update();
+            if completed || previous.changed().await.is_err() {
+                break;
+            }
+        }
+    }
+}
+
+impl SlackIngressOrder {
+    fn register(&mut self, key: String) -> SlackIngressTurn {
+        self.tails.retain(|_, tail| !*tail.borrow());
+        let (completed, tail) = watch::channel(false);
+        let predecessor = self.tails.insert(key, tail);
+        let (finished, worker_done) = tokio::sync::oneshot::channel();
+        let bridge_predecessor = predecessor.clone();
+        // Keep predecessor ordering even if a waiting middle worker is aborted:
+        // its successor cannot bypass an earlier worker still preparing a turn.
+        tokio::spawn(async move {
+            wait_for_slack_ingress(bridge_predecessor).await;
+            let _ = worker_done.await;
+            let _ = completed.send(true);
+        });
+        SlackIngressTurn { predecessor, _finished: finished }
+    }
+}
+
+impl SlackIngressTurn {
+    async fn wait(mut self) -> Self {
+        wait_for_slack_ingress(self.predecessor.take()).await;
+        self
+    }
 }
 
